---
const { title = "shubhankar's site" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="data:;base64,iVBORw0KGgo=">
    <style is:global>
        :root {
            --bg: #05070a;
            --accent: #d2ecff;
            --text-dim: #8892b0;
        }
        body {
            margin: 0;
            background-color: var(--bg);
            color: var(--accent);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        nav {
            display: flex;
            justify-content: center;
            padding: 3rem 0;
            gap: 2.5rem;
            position: relative;
            z-index: 10;
        }
        nav a {
            color: var(--accent);
            text-decoration: none;
            font-size: 0.8rem;
            letter-spacing: 0.1rem;
            text-transform: uppercase;
            opacity: 0.5;
            transition: 0.2s ease;
        }
        nav a:hover { opacity: 1; text-shadow: 0 0 1px var(--accent); }
        
        main {
            max-width: 1000px;
            margin: 0 auto;
            padding: 2rem;
            position: relative;
            z-index: 5;

            flex: 1;
            width: 100%;
        }

        #starfield {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: -1;
            pointer-events: none;
        }

        #oneko {
            z-index: 9999 !important;
            position: fixed !important;
        }
    </style>
</head>
<body>
    <canvas id="starfield"></canvas>
    
    <nav>
        <a href="/">home</a>
        <a href="/blog">blog</a>
        <a href="/contact">contact</a>
    </nav>

    <main>
        <slot />
    </main>

    <script is:inline>
        // star background logic
        const canvas = document.getElementById('starfield');
        const ctx = canvas.getContext('2d');
        let stars = [];

        function initStars() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            stars = [];
            for (let i = 0; i < 250; i++) {
                stars.push({
                    x: Math.random() * canvas.width - canvas.width / 2,
                    y: Math.random() * canvas.height - canvas.height / 2,
                    z: Math.random() * canvas.width
                });
            }
        }

        function animate() {
            ctx.fillStyle = "#05070a";
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            
            stars.forEach(s => {
                s.z -= 3.5; // speed
                if (s.z <= 0) s.z = canvas.width;

                const x = (s.x * (canvas.width / s.z)) + canvas.width / 2;
                const y = (s.y * (canvas.width / s.z)) + canvas.height / 2;
                const size = (1 - s.z / canvas.width) * 2.5;

                ctx.beginPath();
                ctx.arc(x, y, size, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(225, 232, 237, ${1 - s.z / canvas.width})`;
                ctx.fill();
            });
            requestAnimationFrame(animate);
        }

        window.addEventListener('resize', initStars);
        initStars();
        animate();
    </script>

    <script>
    // obfuscate text script
    function obfuscate() {
        const elements = document.querySelectorAll('.magic');
        const chars = "¡¢£¤¥¦§¨©ª«¬®¯°±²³´µ¶·¸¹º»¼½¾¿ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖ×ØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõö÷øùúûüýþÿ";
        
        elements.forEach(el => {
            const htmlEl = el as HTMLElement; 
            const len = htmlEl.innerText.length;
            
            setInterval(() => {
            let result = '';
            for (let i = 0; i < len; i++) {
                result += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            htmlEl.innerText = result;
            }, 40); // speed (higher number = slower)
        });
        }

        window.addEventListener('load', obfuscate);
    </script>

    <script is:inline src="/oneko.js"></script>
    <script is:inline>
        // oneko cat script
        window.addEventListener('load', () => {
            if (typeof oneko !== 'undefined') {
                oneko();
            }
            const cat = document.getElementById('oneko');
            if (cat) {
                cat.style.backgroundImage = "url('/oneko.gif')";
            }
        });
    </script>

    <footer class="site-footer">
        <div class="footer-content">
            <span class="copyright">© {new Date().getFullYear()} Shubhankar Nehra</span>
        </div>
    </footer>

    <style>
        .site-footer {
            padding: 3rem 0 2rem;
            display: flex;
            justify-content: center;
            position: relative;
            z-index: 10;
        }

        .footer-content {
            display: flex;
            gap: 20px;
            font-size: 0.8rem;
            letter-spacing: 1px;
            opacity: 0.3;
        }
    </style>
</body>
</html>