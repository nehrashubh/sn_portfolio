---
import Layout from '../layouts/layout.astro';
const posts = await Astro.glob('./blog/*.md');

// sort posts by date
const sortedPosts = posts.sort((a, b) => 
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);
---

<Layout title="blog - shubhankar's site">
  <section class="blog-wrapper">
    <div class="post-list">
      {sortedPosts.map((post) => (
        <a href={post.url} class="post-item">
          <div class="post-meta">
            <span class="date">{post.frontmatter.date}</span>
          </div>
          <div class="post-content">
            <span class="title">{post.frontmatter.title}</span>
            <span class="description">{post.frontmatter.description}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <style>
    .post-list { 
      display: flex; 
      flex-direction: column; 
      gap: 0.2rem; 
    }
    
    .post-item {
      display: grid;
      grid-template-columns: 120px 1fr;
      gap: 20px;
      text-decoration: none;
      color: var(--text-dim);
      padding: 0.67rem 0;
      border-bottom: 1px solid rgba(225, 232, 237, 0.05);
      transition: all 0.2s ease;
    }

    .post-item:last-child {
      border-bottom: none;
    }

    .post-item:hover { 
      color: var(--accent); 
      padding-left: 10px;
      background: rgba(225, 232, 237, 0.02);
    }

    .post-meta {
      display: flex;
      align-items: baseline;
    }

    .date { 
      font-family: monospace; 
      font-size: 1.2rem; 
      opacity: 0.4; 
    }

    .post-content {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }

    .title { 
      font-weight: 500; 
      font-size: 1.1rem;
      color: var(--accent);
    }

    .description { 
      font-size: 0.9rem; 
      opacity: 0.6;
      line-height: 0.8;
    }

    @media (max-width: 600px) {
      .post-item {
        grid-template-columns: 1fr;
        gap: 8px;
      }
    }
  </style>
</Layout>