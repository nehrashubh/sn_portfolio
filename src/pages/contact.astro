---
import Layout from '../layouts/layout.astro';
---

<Layout title="Contact">
  <section class="contact-wrapper">
    <header class="page-header">
      <p>Reach out for collaborations, security talk, or just to say hi.</p>
    </header>

    <div class="contact-grid">
      <div class="links-section">
        <div class="contact-item">
            <span class="label">Gmail</span>
            <a href="mailto:nehrashubh6@gmail.com" class="value">nehrashubh6@gmail.com</a>
        </div>
        <div class="contact-item">
            <span class="label">Linkedin</span>
            <a href="https://linkedin.com/in/nehrashubh" class="value">Shubhankar Nehra</a>
        </div>
        <div class="contact-item">
            <span class="label">GitHub</span>
            <a href="https://github.com/nehrashubh" target="_blank" class="value">github.com/nehrashubh</a>
        </div>
        <div class="contact-item">
            <span class="label">Discord</span>
            <span class="value">sleepylegs.</span>
        </div>
      </div>
      </div>
    </div>
  </section>

  <style>
    .contact-wrapper {
      margin-top: 5vh;
      animation: fadeIn 0.8s ease-out;
    }

    .page-header { margin-bottom: 4rem; }
    
    h2 { 
      font-weight: 300; 
      font-size: 1.5rem; 
      margin-bottom: 0.5rem;
      color: var(--accent);
    }

    .page-header p {
      color: var(--text-dim);
      font-size: 0.9rem;
    }

    .contact-grid {
      display: flex;
      flex-direction: column;
      gap: 5rem;
    }

    /* Links Styles */
    .links-section {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .contact-item {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .label {
      font-family: monospace;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: var(--accent);
      opacity: 0.4;
    }

    .value {
      font-size: 1.2rem;
      color: var(--accent);
      text-decoration: none;
      transition: opacity 0.2s;
    }

    a.value:hover {
      opacity: 0.7;
    }

    /* 88x31 Button Grid */
    .section-title {
      font-family: monospace;
      font-size: 0.8rem;
      color: var(--accent);
      opacity: 0.6;
      margin-bottom: 1.5rem;
    }

    .button-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .button-grid img {
      width: 88px;
      height: 31px;
      image-rendering: pixelated;
      border: 1px solid rgba(225, 232, 237, 0.1);
    }

    .placeholder-button {
      width: 88px;
      height: 31px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(225, 232, 237, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 9px;
      color: #444;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .note {
      font-size: 0.8rem;
      color: var(--text-dim);
      margin-top: 1.5rem;
      font-style: italic;
      opacity: 0.6;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>